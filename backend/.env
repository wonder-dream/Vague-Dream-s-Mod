# =============================================================
# MyToolkit 环境变量
# =============================================================
# 使用方式：复制为 .env，填入实际值
#   cp .env.example .env
#
# 配置会被 core/src/core/config.py 里的 Settings 类自动读取。
# 变量名和 Settings 类的字段名一一对应，改这里就行，不用改代码。
# =============================================================


# ── 运行环境 ──────────────────────────────────────────────
# dev  = 开发环境（本地 Windows）
# prod = 生产环境（阿里云 Docker）
APP_ENV=dev
DEBUG=true


# ── 数据库 ─────────────────────────────────────────────────
# 开发环境：localhost（Docker 映射出来的端口）
# 生产环境：db（Docker Compose 里的服务名）
DATABASE_URL=postgresql+asyncpg://toolkit:toolkit@localhost:5432/toolkit

# 生产环境的数据库密码（部署时改成强密码，配合 Docker Compose 使用）
DB_PASSWORD=change-me-strong-password


# ── 安全 ───────────────────────────────────────────────────
# JWT 签名密钥，生产环境必须换成一个长的随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15000
JWT_REFRESH_TOKEN_EXPIRE_DAYS=70


# ── 服务器 ─────────────────────────────────────────────────
# FastAPI 监听地址和端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 前端地址（用于 CORS 白名单）
# 开发环境：Vite 默认端口
# 生产环境：你的域名
CORS_ORIGINS=http://localhost:5173,http://localhost:1420


# ── LLM：DeepSeek V4 ─────────────────────────────────────
# 注册地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-5656a533e2a143418c91e0a568ddca82
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# ── Embedding：Qwen3-Embedding-8B ─────────────────────────
# 推荐渠道：SiliconFlow（https://siliconflow.cn）或阿里云百炼
# 不填也不影响第一版运行，向量检索是第二阶段才实现的
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://api.siliconflow.cn/v1
# 向量维度，Qwen3 支持 32-4096，推荐 1536
EMBEDDING_DIMENSIONS=1536


# ── 存储路径 ──────────────────────────────────────────────
# 开发环境：项目目录下的 data 文件夹
# 生产环境：挂载的数据卷路径
DATA_PATH=./data

# 用户笔记的 Markdown 文件存储位置
NOTES_STORAGE_PATH=./data/notes


# ── 备份 ───────────────────────────────────────────────────
# 开发环境可以先不管，生产环境配 Docker 数据卷路径
BACKUP_DIR=./data/backups
# 自动备份保留天数
BACKUP_RETENTION_DAYS=7
# 每天几点执行自动备份（24小时制）
BACKUP_SCHEDULE_HOUR=3


# ── 前端 ───────────────────────────────────────────────────
# Tauri 桌面应用配置
# 生产环境的 API 地址（你的域名）
FRONTEND_API_BASE_URL=http://localhost:8000


# ── 监控（可选）────────────────────────────────────────────
# LangSmith 用于调试 LLM 调用链，没有账号可以删掉这几行
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_TRACING_V2=true
# LANGSMITH_PROJECT=mytoolkit
